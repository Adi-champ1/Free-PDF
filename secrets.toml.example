# Copy to .streamlit/secrets.toml for local runs, or paste into
# Streamlit Cloud -> your app -> Settings -> Secrets.  NEVER commit the real file.

APP_PASSWORD = "choose-a-strong-password"      # remove this line to disable the login
DRIVE_FOLDER_ID = "1t_EqD-5qVsF-pv6GxHnF6lxs5N9yYPJH"

# Option A (recommended) — your own Google account, works with a normal My Drive folder
[google_oauth]
client_id = "xxxxxxxx.apps.googleusercontent.com"
client_secret = "GOCSPX-xxxxxxxx"
refresh_token = "1//xxxxxxxx"

# Option B — service account (ONLY if the folder is inside a Shared Drive)
# [gcp_service_account]
# type = "service_account"
# project_id = "..."
# private_key_id = "..."
# private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# client_email = "...@....iam.gserviceaccount.com"
# client_id = "..."
# token_uri = "https://oauth2.googleapis.com/token"
